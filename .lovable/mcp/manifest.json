{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bxfwxkuyxwkpiigowddo.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "civic-connect-bangladesh",
      "version": "0.1.0",
      "title": "Civic Connect Bangladesh"
    },
    "tools": [
      {
        "name": "list_community_posts",
        "title": "List community posts",
        "description": "List posts from the Protidhwani community feed (বাংলা/English), optionally filtered by kind, district or a text search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Filter by post kind.",
              "type": "string",
              "enum": [
                "report",
                "emergency",
                "verified",
                "discussion",
                "rights",
                "missing",
                "poll",
                "event"
              ]
            },
            "district": {
              "description": "Filter by district name.",
              "type": "string"
            },
            "search": {
              "description": "Free-text search over title, body and location.",
              "type": "string"
            },
            "mine": {
              "description": "Only posts created by the signed-in user.",
              "type": "boolean"
            },
            "sort": {
              "description": "Sort order; defaults to recent.",
              "type": "string",
              "enum": [
                "recent",
                "top",
                "discussed"
              ]
            },
            "limit": {
              "description": "Max posts to return (1-50, default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_community_post",
        "title": "Get a community post",
        "description": "Read one Protidhwani community post together with its most recent comments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post_id": {
              "type": "string",
              "description": "UUID of the post."
            },
            "comment_limit": {
              "description": "Comments to include (0-50, default 10).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "post_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_community_post",
        "title": "Create a community post",
        "description": "Publish a post to the Protidhwani community feed as the signed-in citizen. Bangla title/body are required; English versions are optional.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "report",
                "emergency",
                "verified",
                "discussion",
                "rights",
                "missing",
                "poll",
                "event"
              ],
              "description": "Post kind."
            },
            "title": {
              "type": "string",
              "description": "Bangla title, 3-200 characters."
            },
            "body": {
              "type": "string",
              "description": "Bangla body, 5-5000 characters."
            },
            "title_en": {
              "description": "Optional English title.",
              "type": "string"
            },
            "body_en": {
              "description": "Optional English body.",
              "type": "string"
            },
            "location": {
              "description": "Area / street / landmark.",
              "type": "string"
            },
            "district": {
              "description": "District name.",
              "type": "string"
            },
            "tags": {
              "description": "Topic tags.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "level": {
              "description": "Urgency level for report/emergency posts.",
              "type": "string",
              "enum": [
                "critical",
                "high",
                "moderate"
              ]
            }
          },
          "required": [
            "kind",
            "title",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "comment_on_post",
        "title": "Comment on a community post",
        "description": "Add a comment to a Protidhwani community post as the signed-in citizen.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post_id": {
              "type": "string",
              "description": "UUID of the post to comment on."
            },
            "body": {
              "type": "string",
              "description": "Comment text, 1-2000 characters."
            }
          },
          "required": [
            "post_id",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "support_post",
        "title": "Support or unsupport a post",
        "description": "Add or remove the signed-in citizen's support (upvote) on a Protidhwani community post.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post_id": {
              "type": "string",
              "description": "UUID of the post."
            },
            "supported": {
              "type": "boolean",
              "description": "true to support, false to remove support."
            }
          },
          "required": [
            "post_id",
            "supported"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_complaints",
        "title": "List civic complaints",
        "description": "List civic complaints filed on Protidhwani, optionally only the signed-in citizen's own complaints or a given status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "mine": {
              "description": "Only complaints filed by the signed-in user.",
              "type": "boolean"
            },
            "status": {
              "description": "Filter by complaint status.",
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved",
                "rejected"
              ]
            },
            "district": {
              "description": "Filter by district.",
              "type": "string"
            },
            "limit": {
              "description": "Max complaints to return (1-50, default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_complaint",
        "title": "File a civic complaint",
        "description": "File a civic complaint on Protidhwani as the signed-in citizen (roads, water, electricity, waste and similar issues).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Short complaint title."
            },
            "description": {
              "type": "string",
              "description": "Full description of the civic issue."
            },
            "location": {
              "description": "Area / street / landmark.",
              "type": "string"
            },
            "district": {
              "description": "District name.",
              "type": "string"
            },
            "category_id": {
              "description": "Optional category UUID.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Get my citizen profile",
        "description": "Read the signed-in citizen's Protidhwani profile plus counts of their posts, comments and complaints.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
